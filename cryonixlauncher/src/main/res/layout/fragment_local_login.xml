<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cryonix_screen_bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_20sdp"
    android:paddingVertical="@dimen/_12sdp">

    <LinearLayout
        android:id="@+id/login_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:background="@drawable/launcher_icon_tile"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/cryonixlauncher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CryonixScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local account" />

            <TextView
                style="@style/CryonixFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use a local profile without online authentication" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_menu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_weight="1"
        android:background="@drawable/cryonix_card"
        android:orientation="horizontal"
        android:padding="@dimen/_18sdp">

        <LinearLayout
            android:id="@+id/login_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/_18sdp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/_58sdp"
                android:layout_height="@dimen/_58sdp"
                android:background="@drawable/launcher_icon_tile"
                android:padding="@dimen/_10sdp"
                android:src="@drawable/cryonixlauncher" />

            <TextView
                style="@style/CryonixScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="Player name" />

            <TextView
                style="@style/CryonixFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:text="3–16 characters. Letters, numbers and underscores are supported." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/login_form"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                style="@style/CryonixFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_online_username_hint" />

            <com.kdt.mcgui.MineEditText
                android:id="@+id/login_edit_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:gravity="center_vertical"
                android:hint="Username"
                android:paddingHorizontal="@dimen/_12sdp"
                android:textColor="@color/primary_text"
                android:imeOptions="flagNoExtractUi"
                android:inputType="text"
                android:textSize="@dimen/_15ssp" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/login_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginTop="@dimen/_14sdp"
                android:onClick="loginMC"
                android:text="Use this account"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>