<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/instance_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cryonix_screen_bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_16sdp"
    android:paddingVertical="@dimen/_10sdp">

    <LinearLayout
        android:id="@+id/instance_editor_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:background="@drawable/launcher_icon_tile"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_px_sliders" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CryonixScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instance profile" />

            <TextView
                style="@style/CryonixFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configure the selected Minecraft instance" />
        </LinearLayout>

        <TextView
            android:id="@+id/textView4"
            style="@style/CryonixFieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROFILE" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/instance_editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/instance_editor_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/editor_identity_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/editor_identity_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/cryonix_card"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp">

                    <TextView
                        style="@style/CryonixFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Identity" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/_58sdp"
                            android:layout_height="@dimen/_58sdp">

                            <ImageView
                                android:id="@+id/vprof_editor_instance_icon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/launcher_icon_tile"
                                android:padding="@dimen/padding_small" />

                            <ImageView
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/cryonix_icon_edit"
                                android:padding="@dimen/_3sdp"
                                android:src="@drawable/ic_px_edit" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/CryonixFieldLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profiles_profile_name" />

                            <EditText
                                android:id="@+id/vprof_editor_instance_name"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_42sdp"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:background="@drawable/cryonix_input_field"
                                android:hint="@string/unnamed"
                                android:inputType="textPersonName"
                                android:paddingHorizontal="@dimen/padding_heavy"
                                android:textColor="@color/primary_text"
                                android:textSize="@dimen/_14ssp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/editor_version_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/cryonix_card"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp">

                    <TextView
                        style="@style/CryonixFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profiles_profile_version" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/vprof_editor_version_spinner"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_weight="1"
                            android:background="@drawable/cryonix_input_field"
                            android:gravity="center_vertical"
                            android:hint="@string/version_select_hint"
                            android:paddingHorizontal="@dimen/padding_heavy"
                            android:textColor="@color/primary_text"
                            android:textSize="@dimen/_14ssp" />

                        <Button
                            android:id="@+id/vprof_editor_version_button"
                            android:layout_width="@dimen/_78sdp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:background="@drawable/cryonix_button_secondary"
                            android:text="@string/global_select"
                            android:textAllCaps="false"
                            android:textColor="@color/accent_blue" />
                    </LinearLayout>

                    <TextView
                        style="@style/CryonixFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="Pick the Minecraft version this profile should launch." />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/editor_runtime_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/editor_runtime_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/cryonix_card"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp">

                    <TextView
                        style="@style/CryonixFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pedit_java_runtime" />

                    <Spinner
                        android:id="@+id/vprof_editor_spinner_runtime"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:background="@drawable/cryonix_spinner_bg"
                        android:dropDownWidth="match_parent"
                        android:popupBackground="#0A1526" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/editor_renderer_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/cryonix_card"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp">

                    <TextView
                        style="@style/CryonixFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pedit_renderer" />

                    <Spinner
                        android:id="@+id/vprof_editor_instance_renderer"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:background="@drawable/cryonix_spinner_bg"
                        android:dropDownWidth="match_parent"
                        android:popupBackground="#0A1526" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/editor_options_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/editor_controls_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/cryonix_card"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp">

                    <TextView
                        style="@style/CryonixFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_control" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/vprof_editor_ctrl_spinner"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_weight="1"
                            android:background="@drawable/cryonix_input_field"
                            android:gravity="center_vertical"
                            android:hint="@string/use_global_default"
                            android:paddingHorizontal="@dimen/padding_heavy"
                            android:textColor="@color/primary_text"
                            android:textSize="@dimen/_13ssp" />

                        <Button
                            android:id="@+id/vprof_editor_ctrl_button"
                            android:layout_width="@dimen/_78sdp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:background="@drawable/cryonix_button_secondary"
                            android:text="@string/global_select"
                            android:textAllCaps="false"
                            android:textColor="@color/accent_blue" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/editor_data_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/cryonix_card"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp">

                    <TextView
                        style="@style/CryonixFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/instance_shared_data" />

                    <CheckBox
                        android:id="@+id/vprof_editor_data_checkbox_container"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:background="@drawable/cryonix_input_field"
                        android:button="@null"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/padding_heavy"
                        android:text="@string/instance_shared_data_off"
                        android:textColor="@color/primary_text" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/editor_jvm_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:background="@drawable/cryonix_card"
                android:orientation="vertical"
                android:padding="@dimen/_12sdp">

                <TextView
                    style="@style/CryonixFieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pvc_jvmArgs" />

                <EditText
                    android:id="@+id/vprof_editor_jre_args"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:background="@drawable/cryonix_input_field"
                    android:hint="@string/use_global_default"
                    android:inputType="text"
                    android:paddingHorizontal="@dimen/padding_heavy"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_13ssp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/instance_editor_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:orientation="horizontal">

        <com.kdt.mcgui.MineButton
            android:id="@+id/vprof_editor_save_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_weight="1"
            android:text="@string/global_save"
            android:textAllCaps="false" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/vprof_editor_delete_button"
            android:layout_width="@dimen/_110sdp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:background="@drawable/cryonix_button_secondary"
            android:text="@string/global_delete"
            android:textAllCaps="false"
            android:textColor="@color/primary_text" />
    </LinearLayout>
</LinearLayout>