<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/about_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A12"
    android:padding="22dp">

    <ImageButton
        android:id="@+id/about_back"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/launcher_action_button"
        android:contentDescription="Back"
        android:padding="11dp"
        android:src="@drawable/ic_launcher_chevron_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#D5D9E0" />

    <ScrollView
        android:id="@+id/about_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/about_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="54dp"
            android:layout_marginEnd="54dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="30dp">

            <ImageView
                android:id="@+id/about_logo"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:background="@drawable/launcher_icon_tile"
                android:contentDescription="Cryonix Launcher"
                android:padding="12dp"
                android:src="@drawable/cryonixlauncher" />

            <TextView
                android:id="@+id/about_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.03"
                android:text="CRYONIX LAUNCHER V3"
                android:textColor="#F1F3F5"
                android:textSize="31sp" />

            <TextView
                android:id="@+id/about_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="About • Architecture • Credits"
                android:textColor="#8F9AA8"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/about_fork_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/launcher_card_flat"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="What is Cryonix Launcher?"
                    android:textColor="#F1F3F5"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="Cryonix Launcher is a mobile-focused Minecraft launcher fork built on the Boardwalk / Mojo Launcher lineage. The project keeps the launcher foundation and extends it with the Cryonix interface, instance workflow, account handling and mobile-focused features."
                    android:textColor="#B5BDC8"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/about_backend_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/launcher_card_flat"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Backend &amp; services"
                    android:textColor="#F1F3F5"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="Cryonix uses backend and service components from the Boardwalk / Mojo launcher ecosystem rather than replacing the underlying mobile Minecraft launch stack. Cryonix-specific work is focused on the UI, launcher flow and integration around those services."
                    android:textColor="#B5BDC8"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="The backend is intentionally kept separate from the visual Cryonix layer."
                    android:textColor="#7E8997"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/about_team_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/launcher_card_flat"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Cryonix development team"
                    android:textColor="#F1F3F5"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Developer  •  NekoStrikeSG"
                    android:textColor="#D5D9E0"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Back-end Developer  •  Raze"
                    android:textColor="#D5D9E0"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Cryonix-specific UI, launcher integration and presentation are maintained as the project evolves."
                    android:textColor="#8F9AA8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/about_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Credits: Boardwalk / Mojo Launcher lineage and its contributors. Cryonix Launcher is a separate project with its own interface and branding."
                android:textColor="#6F7A88"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
