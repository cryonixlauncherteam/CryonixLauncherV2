<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <!-- Video-style floating navigation rail -->
    <LinearLayout
        android:id="@+id/home_sidebar"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/launcher_sidebar_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/sidebar_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/launcher_card_border_bg"
            android:contentDescription="Home"
            android:padding="9dp"
            android:src="@drawable/ic_px_home" />

        <ImageButton
            android:id="@+id/sidebar_ai_assist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cursor"
            android:padding="12dp"
            android:src="@drawable/ic_px_mouse" />

        <Button
            android:id="@+id/custom_control_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Controls"
            android:padding="12dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:drawableStart="@drawable/ic_px_gamepad"
            android:text="" />

        <ImageButton
            android:id="@+id/sidebar_info"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="About"
            android:padding="12dp"
            android:src="@drawable/ic_px_letters" />

        <ImageButton
            android:id="@+id/sidebar_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="12dp"
            android:src="@drawable/ic_px_sliders" />
    </LinearLayout>

    <!-- Brand/header -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/profile_chip"
        app:layout_constraintStart_toEndOf="@id/home_sidebar"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/launcher_icon_tile"
            android:padding="7dp"
            android:src="@drawable/cryonixlauncher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="CRYONIX LAUNCHER V3"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Account chip -->
    <LinearLayout
        android:id="@+id/profile_chip"
        android:layout_width="220dp"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/launcher_card_flat"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/launcher_icon_tile"
            android:padding="5dp"
            android:src="@drawable/cryonixlauncher" />

        <TextView
            android:id="@+id/profile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Account"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Kept for existing profile/version logic; visually replaced by the video-style chip. -->
    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- Main instances area -->
    <LinearLayout
        android:id="@+id/instances_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/ai_assist_card"
        app:layout_constraintEnd_toStartOf="@id/profile_panel"
        app:layout_constraintStart_toEndOf="@id/home_sidebar"
        app:layout_constraintTop_toBottomOf="@id/home_header">

        <LinearLayout
            android:id="@+id/instances_header"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◈"
                android:textColor="@android:color/white"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instances"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="instances"
                    android:textColor="#6F829D"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/instance_counter"
                android:layout_width="54dp"
                android:layout_height="36dp"
                android:background="@drawable/launcher_card_flat"
                android:gravity="center"
                android:text="0/0"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btn_prev_instance"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_px_arrow_left"
                android:contentDescription="Previous instance"
                android:padding="9dp" />

            <ImageButton
                android:id="@+id/btn_next_instance"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_px_chevron_right"
                android:contentDescription="Next instance"
                android:padding="9dp" />

            <ImageButton
                android:id="@+id/btn_add_instance_panel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/launcher_btn_play_circle"
                android:contentDescription="Add instance"
                android:padding="11dp"
                android:src="@drawable/ic_px_dynamic" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/instances_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- Selected instance panel -->
    <LinearLayout
        android:id="@+id/profile_panel"
        android:layout_width="260dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/launcher_card_flat"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/ai_assist_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_chip">

        <ImageView
            android:id="@+id/selected_instance_image"
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:background="@drawable/launcher_icon_tile"
            android:scaleType="centerCrop"
            android:src="@drawable/cryonixlauncher" />

        <TextView
            android:id="@+id/current_instance_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Select an instance"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/current_instance_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#6F829D"
            android:textSize="12sp" />

        <Button
            android:id="@+id/right_launch_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/launcher_btn_play"
            android:text="▶  Launch"
            android:textColor="#071225"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/side_edit_profile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_card_flat"
                    android:text="✎  Edit"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/side_duplicate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_card_flat"
                    android:text="▣  Duplicate"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/side_delete"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_card_flat"
                    android:text="▢  Delete"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/side_open_folder"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_card_flat"
                    android:text="□  Open folder"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/side_menu_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Instance menu"
            android:src="@drawable/ic_launcher_more"
            android:padding="9dp" />
    </LinearLayout>

    <!-- Video-style bottom assistant card -->
    <LinearLayout
        android:id="@+id/ai_assist_card"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/launcher_card_flat"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/profile_panel"
        app:layout_constraintStart_toEndOf="@id/home_sidebar">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/launcher_btn_play_circle"
            android:padding="10dp"
            android:src="@drawable/ic_px_ai" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Assistant"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Follow AI Commands To setup Launcher properly!"
                android:textColor="#6F829D"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Existing actions are retained as invisible compatibility hooks. -->
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/news_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/social_media_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/install_jar_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/share_logs_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/open_files_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <View
        android:id="@+id/btn_toggle_instances"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <View
        android:id="@+id/instances_panel"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
