<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_home_blue"
    android:padding="18dp">

    <!-- Top header: logo + Cryonix Launcher V3 -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/launcher_icon_tile"
            android:padding="10dp"
            android:src="@drawable/cryonixlauncher"
            android:contentDescription="Cryonix Launcher logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRYONIX LAUNCHER V3"
                android:textColor="@color/launcher_icon"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Instances"
                android:textColor="@color/launcher_muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Account -->
    <LinearLayout
        android:id="@+id/profile_chip"
        android:layout_width="265dp"
        android:layout_height="52dp"
        android:background="@drawable/launcher_profile_badge_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/launcher_icon_tile"
            android:padding="7dp"
            android:src="@drawable/cryonixlauncher"
            android:contentDescription="Account" />

        <TextView
            android:id="@+id/profile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Account"
            android:textColor="@color/launcher_icon"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▾"
            android:textColor="@color/launcher_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Left navigation -->
    <LinearLayout
        android:id="@+id/launcher_sidebar"
        android:layout_width="76dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/cryonix_sidebar_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_header">

        <ImageButton
            android:id="@+id/sidebar_home"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/launcher_sidebar_home_bg"
            android:contentDescription="Home"
            android:padding="12dp"
            android:src="@drawable/ic_px_home"
            app:tint="@color/launcher_icon" />

        <Space
            android:layout_width="1dp"
            android:layout_height="14dp" />

        <ImageButton
            android:id="@+id/custom_control_button"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Controls"
            android:padding="13dp"
            android:src="@drawable/ic_px_gamepad"
            app:tint="@color/launcher_icon" />

        <Space
            android:layout_width="1dp"
            android:layout_height="14dp" />

        <ImageButton
            android:id="@+id/sidebar_cursor_customization"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cursor customization"
            android:padding="13dp"
            android:src="@drawable/ic_sidebar_cursor"
            app:tint="@color/launcher_icon" />

        <Space
            android:layout_width="1dp"
            android:layout_height="14dp" />

        <ImageButton
            android:id="@+id/install_jar_button"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="About"
            android:padding="13dp"
            android:src="@drawable/ic_px_letters"
            app:tint="@color/launcher_icon" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/sidebar_settings"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="13dp"
            android:src="@drawable/ic_px_sliders"
            app:tint="@color/launcher_icon" />
    </LinearLayout>

    <!-- Main instances area -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="18dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/instances_panel"
        app:layout_constraintEnd_toStartOf="@id/right_launch_card"
        app:layout_constraintStart_toEndOf="@id/launcher_sidebar"
        app:layout_constraintTop_toBottomOf="@id/home_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instances"
                    android:textColor="@color/launcher_icon"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="instances"
                    android:textColor="@color/launcher_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/instance_counter"
                android:layout_width="46dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="1/1"
                android:textColor="@color/launcher_muted"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btn_prev_instance"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous instance"
                android:src="@drawable/ic_px_arrow_left"
                app:tint="@color/launcher_muted" />

            <ImageButton
                android:id="@+id/btn_next_instance"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next instance"
                android:src="@drawable/ic_px_arrow_right"
                app:tint="@color/launcher_muted" />

            <ImageButton
                android:id="@+id/btn_add_instance_panel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/launcher_btn_play_circle"
                android:contentDescription="Add instance"
                android:padding="10dp"
                android:src="@android:drawable/ic_input_add"
                app:tint="@android:color/white" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/instances_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/instances_header"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Selected instance / launch panel -->
    <LinearLayout
        android:id="@+id/right_launch_card"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/launcher_card_flat"
        android:gravity="top"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintBottom_toBottomOf="@id/instances_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_chip">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:background="@drawable/launcher_icon_tile">

            <ImageView
                android:id="@+id/launch_account_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/cryonixlauncher"
                android:visibility="gone"
                android:contentDescription="Instance preview" />
        </FrameLayout>

        <TextView
            android:id="@+id/current_instance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Fabric"
            android:textColor="@color/launcher_icon"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/current_instance_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="fabric-loader-0.19.5-26.3"
            android:textColor="@color/launcher_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/launcher_status_ready" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Ready"
                android:textColor="#00D6A0"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/right_launch_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/launcher_btn_white"
            android:stateListAnimator="@null"
            android:text="▶  Launch"
            android:textColor="#14283B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/side_edit_profile"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_card_border_bg"
                android:text="✎  Edit"
                android:textColor="@color/launcher_icon"
                android:textSize="13sp" />

            <Button
                android:id="@+id/side_duplicate"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_card_border_bg"
                android:text="□  Duplicate"
                android:textColor="@color/launcher_icon"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/side_delete"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_card_border_bg"
                android:text="▣  Delete"
                android:textColor="@color/launcher_icon"
                android:textSize="13sp" />

            <Button
                android:id="@+id/side_open_folder"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_card_border_bg"
                android:text="□  Open Folder"
                android:textColor="@color/launcher_icon"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/side_menu_button"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/launch_add_account"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom strip keeps the reference layout clean; no AI assistant button. -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/main_content"
        app:layout_constraintEnd_toStartOf="@id/right_launch_card" />

    <!-- Legacy IDs kept hidden so existing Java/Kotlin code continues to compile. -->
    <LinearLayout android:id="@+id/home_sidebar" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/profile_panel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageButton android:id="@+id/edit_profile_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <Button android:id="@+id/play_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageButton android:id="@+id/btn_toggle_instances" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <Button android:id="@+id/news_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <Button android:id="@+id/social_media_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <Button android:id="@+id/install_jar_button2" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <Button android:id="@+id/share_logs_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <Button android:id="@+id/open_files_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>