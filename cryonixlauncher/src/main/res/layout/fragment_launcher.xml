<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_app" android:padding="10dp">

    <LinearLayout android:id="@+id/profile_chip" android:layout_width="180dp" android:layout_height="42dp"
        android:background="@drawable/launcher_profile_badge_bg" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <TextView android:id="@+id/profile_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text=""
            android:textColor="@color/launcher_icon" android:textSize="13sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▾"
            android:textColor="@color/launcher_muted" android:textSize="15sp"/>
    </LinearLayout>

    <ImageButton android:id="@+id/sidebar_settings" android:layout_width="40dp" android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Settings"
        android:padding="7dp" android:src="@drawable/ic_px_sliders" app:tint="@color/launcher_icon"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout android:id="@+id/launcher_sidebar" android:layout_width="44dp" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/launcher_sidebar_bg" android:gravity="center_horizontal"
        android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_chip">
        <ImageButton android:id="@+id/sidebar_home" android:layout_width="30dp" android:layout_height="30dp"
            android:layout_marginBottom="4dp" android:background="@drawable/launcher_card_border_bg" android:contentDescription="Home"
            android:padding="6dp" android:src="@drawable/ic_px_home" app:tint="@color/launcher_icon"/>
        <ImageButton android:id="@+id/custom_control_button" android:layout_width="30dp" android:layout_height="30dp"
            android:layout_marginBottom="4dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Controls"
            android:padding="6dp" android:src="@drawable/ic_px_gamepad" app:tint="@color/launcher_icon"/>
        <ImageButton android:id="@+id/sidebar_cursor_customization" android:layout_width="30dp" android:layout_height="30dp"
            android:layout_marginBottom="4dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Cursor customization"
            android:padding="6dp" android:src="@drawable/ic_sidebar_cursor" app:tint="@color/launcher_icon"/>
        <ImageButton android:id="@+id/install_jar_button" android:layout_width="30dp" android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="About"
            android:padding="6dp" android:src="@drawable/ic_px_letters" app:tint="@color/launcher_icon"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/main_content" android:layout_width="0dp" android:layout_height="0dp"
        android:gravity="center" android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/launcher_sidebar" app:layout_constraintTop_toBottomOf="@id/profile_chip">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select version"
            android:textColor="@color/launcher_muted" android:textSize="12sp"/>
        <com.kdt.mcgui.mcVersionSpinner android:id="@+id/mc_version_spinner" android:layout_width="240dp" android:layout_height="42dp"
            android:layout_marginTop="6dp"/>
        <Button android:id="@+id/right_launch_button" android:layout_width="210dp" android:layout_height="48dp"
            android:layout_marginTop="16dp" android:background="@drawable/launcher_btn_play" android:stateListAnimator="@null"
            android:text="▶  Launch" android:textColor="@color/background_app" android:textSize="15sp" android:textStyle="bold"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/instances_list" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/instances_panel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/profile_panel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/edit_profile_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <Button android:id="@+id/play_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/btn_toggle_instances" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <Button android:id="@+id/side_edit_profile" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <Button android:id="@+id/side_duplicate" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <Button android:id="@+id/side_delete" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <Button android:id="@+id/side_open_folder" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/side_menu_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/btn_prev_instance" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/btn_next_instance" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/btn_add_instance_panel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/news_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/social_media_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/install_jar_button2" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/share_logs_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/open_files_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
</androidx.constraintlayout.widget.ConstraintLayout>