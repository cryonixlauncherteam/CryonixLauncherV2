<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/instance_card_root"
    android:layout_width="match_parent"
    android:layout_height="118dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/launcher_card_flat"
    android:padding="16dp">

    <ImageView
        android:id="@+id/instance_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/launcher_icon_tile"
        android:contentDescription="Instance icon"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/cryonixlauncher"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="54dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/instance_icon"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/instance_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="Fabric"
            android:textColor="@android:color/white"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/instance_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="fabric-loader-0.19.5-26.3"
            android:textColor="#7187A2"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <View
                android:id="@+id/instance_status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/launcher_status_ready" />

            <TextView
                android:id="@+id/instance_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Ready"
                android:textColor="#00D6A0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/instance_menu"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Instance options"
        android:padding="5dp"
        android:src="@drawable/ic_launcher_more"
        app:tint="#7187A2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/instance_play_small"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/launcher_btn_play_circle"
        android:contentDescription="Launch instance"
        android:padding="11dp"
        android:src="@drawable/ic_launcher_play"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>