<!-- ========== TOP BAR ========== -->
<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/cryonix_top_bar"
    android:layout_width="0dp"
    android:layout_height="56dp"
    android:background="@color/background_status_bar"
    android:paddingStart="16dp"
    android:paddingTop="7dp"
    android:paddingEnd="16dp"
    android:paddingBottom="7dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/brand_block"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Logo"
            android:padding="4dp"
            android:src="@drawable/cryonixlauncher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:text="CRYONIX LAUNCHER"
            android:textColor="@color/primary_text"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/profile_chip"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="@drawable/launcher_profile_badge_bg"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/launcher_icon_tile"
            android:contentDescription="Profile"
            android:padding="4dp"
            android:src="@drawable/cryonixlauncher" />

        <TextView
            android:id="@+id/profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxWidth="140dp"
            android:singleLine="true"
            android:text="nemosteikwzh"
            android:textColor="@color/primary_text"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>