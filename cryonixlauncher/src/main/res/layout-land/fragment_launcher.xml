<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_launcher_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#151719" android:padding="12dp">
    <LinearLayout android:id="@+id/profile_chip" android:layout_width="190dp" android:layout_height="42dp"
        android:background="@drawable/launcher_profile_badge_bg" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <TextView android:id="@+id/profile_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:ellipsize="end" android:maxLines="1" android:text="Account" android:textColor="@color/launcher_icon" android:textSize="13sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▾"
            android:textColor="@color/launcher_muted" android:textSize="15sp"/>
    </LinearLayout>
    <ImageButton android:id="@+id/sidebar_settings" android:layout_width="40dp" android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Settings" android:padding="7dp"
        android:src="@drawable/ic_sidebar_sliders" app:tint="@color/launcher_icon"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout android:id="@+id/launcher_sidebar" android:layout_width="54dp" android:layout_height="0dp"
        android:layout_marginTop="10dp" android:layout_marginBottom="6dp" android:background="@drawable/cryonix_sidebar_pill"
        android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/instances_panel" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_chip">
        <ImageButton android:id="@+id/sidebar_home" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/launcher_sidebar_home_bg" android:contentDescription="Home" android:padding="9dp"
            android:src="@drawable/ic_clean_home" app:tint="@color/launcher_icon"/>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
        <ImageButton android:id="@+id/custom_control_button" android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Controls" android:padding="9dp"
            android:src="@drawable/ic_clean_gamepad" app:tint="@color/launcher_icon"/>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
        <ImageButton android:id="@+id/sidebar_cursor_customization" android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Cursor customization" android:padding="9dp"
            android:src="@drawable/ic_sidebar_pointer" app:tint="@color/launcher_icon"/>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
        <ImageButton android:id="@+id/install_jar_button" android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="About" android:padding="9dp"
            android:src="@drawable/ic_sidebar_info" app:tint="@color/launcher_icon"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/main_content" android:layout_width="0dp" android:layout_height="0dp"
        android:gravity="center" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp"
        app:layout_constraintBottom_toTopOf="@id/instances_panel" app:layout_constraintEnd_toStartOf="@id/right_launch_card"
        app:layout_constraintStart_toEndOf="@id/launcher_sidebar" app:layout_constraintTop_toBottomOf="@id/profile_chip">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select version"
            android:textColor="@color/launcher_muted" android:textSize="12sp"/>
        <com.kdt.mcgui.mcVersionSpinner android:id="@+id/mc_version_spinner" android:layout_width="260dp" android:layout_height="42dp"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/right_launch_card" android:layout_width="190dp" android:layout_height="230dp"
        android:layout_marginEnd="12dp" android:background="@drawable/launcher_card_flat" android:gravity="center"
        android:orientation="vertical" android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="@id/main_content" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/main_content">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ready to play"
            android:textColor="@color/launcher_icon" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:gravity="center" android:text="Launch Minecraft" android:textColor="@color/launcher_muted" android:textSize="11sp"/>
        <Button android:id="@+id/right_launch_button" android:layout_width="160dp" android:layout_height="50dp"
            android:layout_marginTop="18dp" android:background="@drawable/launcher_btn_play" android:stateListAnimator="@null"
            android:text="▶  Launch" android:textColor="@color/background_app" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/instances_panel" android:layout_width="0dp" android:layout_height="104dp"
        android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:background="@drawable/launcher_card_flat"
        android:orientation="vertical" android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/right_launch_card"
        app:layout_constraintStart_toEndOf="@id/launcher_sidebar">
        <TextView android:id="@+id/instances_header" android:layout_width="wrap_content" android:layout_height="18dp"
            android:text="Instances" android:textColor="@color/launcher_icon" android:textSize="12sp" android:textStyle="bold"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/instances_list" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:overScrollMode="never"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/home_sidebar" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/home_header" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <TextView android:id="@+id/instance_counter" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <TextView android:id="@+id/current_instance_label" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <TextView android:id="@+id/current_instance_version" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/profile_panel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/edit_profile_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <Button android:id="@+id/play_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/btn_toggle_instances" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <Button android:id="@+id/side_edit_profile" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <Button android:id="@+id/side_duplicate" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <Button android:id="@+id/side_delete" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <Button android:id="@+id/side_open_folder" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/side_menu_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/btn_prev_instance" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/btn_next_instance" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/btn_add_instance_panel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/news_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/social_media_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/install_jar_button2" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/share_logs_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <com.kdt.mcgui.LauncherMenuButton android:id="@+id/open_files_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
</androidx.constraintlayout.widget.ConstraintLayout>