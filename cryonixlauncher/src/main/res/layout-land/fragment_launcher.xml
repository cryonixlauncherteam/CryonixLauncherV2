<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cryonix_screen_bg"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- ========== LEFT SIDEBAR ========== -->
    <LinearLayout
        android:id="@+id/launcher_sidebar"
        android:layout_width="56dp"
        android:layout_height="0dp"
        android:background="@drawable/cryonix_sidebar_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/sidebar_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/launcher_sidebar_home_bg"
            android:contentDescription="Home"
            android:padding="9dp"
            android:src="@drawable/ic_clean_home"
            app:tint="@color/launcher_icon" />

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageButton
            android:id="@+id/sidebar_ai_assist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cursor customization"
            android:padding="9dp"
            android:src="@drawable/ic_sidebar_pointer"
            app:tint="@color/launcher_muted" />

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageButton
            android:id="@+id/custom_control_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Controls"
            android:padding="9dp"
            android:src="@drawable/ic_clean_gamepad"
            app:tint="@color/launcher_muted" />

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageButton
            android:id="@+id/install_jar_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Info"
            android:padding="9dp"
            android:src="@drawable/ic_sidebar_info"
            app:tint="@color/launcher_muted" />

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageButton
            android:id="@+id/sidebar_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="9dp"
            android:src="@drawable/ic_sidebar_sliders"
            app:tint="@color/launcher_muted" />
    </LinearLayout>

    <!-- ========== CENTER: INSTANCES ========== -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/profile_panel"
        app:layout_constraintStart_toEndOf="@id/launcher_sidebar"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/instances_panel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Instances"
                android:padding="6dp"
                android:src="@drawable/ic_launcher_cube"
                app:tint="@color/launcher_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/instances_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Instances"
                    android:textColor="@color/primary_text"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your game profiles"
                    android:textColor="@color/launcher_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/instance_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/launcher_counter_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="2/2"
                android:textColor="@color/launcher_accent"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_prev_instance"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:padding="8dp"
                android:src="@drawable/ic_launcher_chevron_left"
                app:tint="@color/launcher_accent" />

            <ImageButton
                android:id="@+id/btn_next_instance"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:padding="8dp"
                android:src="@drawable/ic_launcher_chevron_right"
                app:tint="@color/launcher_accent" />

            <ImageButton
                android:id="@+id/btn_add_instance_panel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/launcher_btn_play_circle"
                android:contentDescription="Add Instance"
                android:padding="9dp"
                android:src="@drawable/ic_add"
                app:tint="@color/launcher_icon" />
        </LinearLayout>

        <!-- List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/instances_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            tools:listitem="@layout/item_instance" />
    </LinearLayout>

    <!-- ========== RIGHT: SELECTED INSTANCE PANEL ========== -->
    <LinearLayout
        android:id="@+id/profile_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/launcher_card_flat"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="300dp"
        app:layout_constraintWidth_percent="0.34">

        <ImageView
            android:id="@+id/selected_instance_preview"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@drawable/launcher_world_preview"
            android:contentDescription="Selected instance preview"
            android:scaleType="centerCrop"
            android:src="@drawable/cryonix_world_sunset" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/current_instance_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:singleLine="true"
                        android:text="Fabric"
                        android:textColor="@color/primary_text"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/side_menu_button"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Options"
                        android:padding="6dp"
                        android:src="@drawable/ic_launcher_more"
                        app:tint="@color/launcher_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/current_instance_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="fabric-loader-0.19.5-26.3"
                    android:textColor="@color/launcher_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/launcher_status_ready" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Ready"
                        android:textColor="@color/cryonix_ready"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/right_launch_button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/launcher_play_pill_white"
                    android:fontFamily="sans-serif-black"
                    android:stateListAnimator="@null"
                    android:text="▶  Launch"
                    android:textColor="@color/launcher_on_light"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/side_edit_profile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/launcher_action_button"
                        android:drawableStart="@drawable/ic_launcher_edit"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:text="Edit"
                        android:textColor="@color/primary_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/side_duplicate"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/launcher_action_button"
                        android:drawableStart="@drawable/ic_launcher_copy"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="Duplicate"
                        android:textColor="@color/primary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/side_delete"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/launcher_action_button"
                        android:drawableStart="@drawable/ic_launcher_delete"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:text="Delete"
                        android:textColor="@color/primary_text"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/side_open_folder"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/launcher_action_button"
                        android:drawableStart="@drawable/ic_launcher_folder"
                        android:paddingStart="8dp"
                        android:paddingEnd="6dp"
                        android:text="Folder"
                        android:textColor="@color/primary_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- ========== HIDDEN BACKWARD-COMPATIBLE VIEWS ========== -->
    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:src="@drawable/ic_px_edit"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btn_toggle_instances"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/play_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>