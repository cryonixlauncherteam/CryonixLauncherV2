<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/background_app</item>
        <item name="android:colorBackground">@color/background_app</item>
        <item name="android:popupMenuStyle">@style/CryonixPopupMenuStyle</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:colorAccent">@color/accent_blue</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="preferenceTheme">@style/CryonixPreferenceTheme</item>
        <item name="alertDialogTheme">@style/CryonixAlertDialogTheme</item>

        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="CryonixPreferenceTheme" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="preferenceStyle">@style/CryonixPreferenceStyle</item>
        <item name="preferenceCategoryStyle">@style/CryonixPreferenceCategoryStyle</item>
        <item name="switchPreferenceStyle">@style/CryonixPreferenceStyle</item>
        <item name="checkBoxPreferenceStyle">@style/CryonixPreferenceStyle</item>
        <item name="editTextPreferenceStyle">@style/CryonixPreferenceStyle</item>
        <item name="dialogPreferenceStyle">@style/CryonixPreferenceStyle</item>
        <item name="dropdownPreferenceStyle">@style/CryonixPreferenceStyle</item>
    </style>

    <style name="CryonixPreferenceStyle" parent="@style/Preference.Material">
        <item name="android:layout">@layout/cryonix_preference_item</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="CryonixPreferenceCategoryStyle" parent="@style/Preference.Category.Material">
        <item name="android:layout">@layout/cryonix_preference_category</item>
    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- ===== Cryonix screen kit (used by all screens except home + settings) ===== -->

    <style name="CryonixScreenTitle">
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">@dimen/_18ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CryonixFieldLabel">
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CryonixAccentText">
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">#354047</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="CryonixAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/cryonix_dialog_bg</item>
        <item name="android:windowMinWidthMajor">72%</item>
        <item name="android:windowMinWidthMinor">82%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:colorAccent">@color/accent_blue</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="buttonBarPositiveButtonStyle">@style/CryonixDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CryonixDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/CryonixDialogButton</item>
    </style>

    <style name="CryonixDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CryonixPopupMenuStyle" parent="@style/Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@android:color/black</item>
    </style>
</resources>
